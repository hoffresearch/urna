{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hoffresearch/urna/doc/arc/arc.schema.json",
  "title": "urna architecture reference (doc/arc/arc.yaml)",
  "description": "shape of the single architecture reference: header, layers, flows, the four narrative lists, and the file inventory. the file name arc.yaml collides with the schemastore entry for the architect framework; the modeline at the top of arc.yaml points editors here instead.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "last-updated", "domain", "summary", "layers", "flows", "system_view", "contract", "quality", "risks", "inventory"],
  "properties": {
    "project": { "type": "string", "const": "urna" },
    "last-updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "domain": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "entrypoints", "links"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "entrypoints": { "$ref": "#/definitions/paths" },
          "links": { "$ref": "#/definitions/paths" }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entry", "path", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "path": { "$ref": "#/definitions/paths" },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "system_view": { "$ref": "#/definitions/narrative" },
    "contract": { "$ref": "#/definitions/narrative" },
    "quality": { "$ref": "#/definitions/narrative" },
    "risks": { "$ref": "#/definitions/narrative" },
    "inventory": {
      "type": "object",
      "description": "one list per area; every tracked file or directory worth naming appears exactly once",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "kind", "purpose", "links"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "description": "repo-relative, no leading ./" },
            "kind": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "kebab-case category, e.g. rust-source, python-tool, ci-workflow" },
            "purpose": { "type": "string", "minLength": 1 },
            "links": { "$ref": "#/definitions/paths" }
          }
        }
      }
    }
  },
  "definitions": {
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "repo-relative paths this entry depends on or points at"
    },
    "narrative": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
